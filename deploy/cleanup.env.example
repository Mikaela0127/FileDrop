# Read by filedrop-cleanup.service. Keep the completed file root-owned with mode
# 0600 outside the repository.

# The cleanup endpoint on this deployment's own public origin. The unit fails
# loudly if this is empty rather than calling somewhere unintended.
FILEDROP_CLEANUP_URL=https://filedrop.example.com/api/cron/cleanup

# This must exactly match runtime.env's CRON_SECRET.
CRON_SECRET=
