# This file contains deployment coordinates, not application credentials.
# On the VPS, use absolute paths for the two environment files.
FILEDROP_DOMAIN=filedrop.example.com
FILEDROP_IMAGE=filedrop:local
FILEDROP_OPERATIONS_IMAGE=filedrop-operations:local
# Use the exact 7-40 character hexadecimal Git revision used at image build.
FILEDROP_REVISION=
FILEDROP_RUNTIME_ENV_FILE=/opt/filedrop/config/runtime.env
FILEDROP_MIGRATION_ENV_FILE=/opt/filedrop/config/migration.env

# Only for a host that already runs another reverse proxy on 80/443, together
# with deploy/compose.shared-proxy.example.yaml. Leave both unset on a host
# dedicated to FileDrop; the bundled Caddy service serves that case.
# FILEDROP_PROXY_NETWORK is the existing proxy's Docker network, as shown by
# `docker inspect <proxy container> --format '{{range $n, $_ := .NetworkSettings.Networks}}{{$n}} {{end}}'`.
# FILEDROP_NETWORK_ALIAS is the upstream name that proxy resolves to this app.
#FILEDROP_PROXY_NETWORK=
#FILEDROP_NETWORK_ALIAS=
