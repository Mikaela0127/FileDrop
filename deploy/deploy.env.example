# This file contains deployment coordinates, not application credentials.
# On the VPS, use absolute paths for the two environment files.
FILEDROP_DOMAIN=filedrop.mikaela79.com
FILEDROP_IMAGE=filedrop:local
FILEDROP_OPERATIONS_IMAGE=filedrop-operations:local
# Use the exact 7-40 character hexadecimal Git revision used at image build.
FILEDROP_REVISION=
FILEDROP_RUNTIME_ENV_FILE=/opt/filedrop/config/runtime.env
FILEDROP_MIGRATION_ENV_FILE=/opt/filedrop/config/migration.env
