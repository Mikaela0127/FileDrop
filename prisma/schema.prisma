generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model OperationalLog {
  id String @id @default(uuid()) @db.Uuid
  time DateTime @db.Timestamptz(3)
  level String @db.VarChar(8)
  event String @db.VarChar(32)
  requestId String @map("request_id") @db.Uuid
  payload Json @db.JsonB

  @@index([time, id])
  @@index([level, time, id])
  @@index([requestId])
  @@map("operational_logs")
}

enum FileStatus {
  PENDING
  READY
  FAILED
  EXPIRED
  DELETING
  DELETED
}

model File {
  id               String     @id @default(uuid()) @db.Uuid
  shareTokenHash   String     @unique @map("share_token_hash") @db.Char(64)
  shareTokenCiphertext String? @map("share_token_ciphertext") @db.Text
  manuallyExpiredAt DateTime? @map("manually_expired_at") @db.Timestamptz(3)
  objectKey        String     @unique @map("object_key") @db.VarChar(1024)
  originalName     String     @map("original_name") @db.VarChar(255)
  contentType      String     @map("content_type") @db.VarChar(255)
  sizeBytes        BigInt     @map("size_bytes")
  status           FileStatus @default(PENDING)
  expiresAt        DateTime   @map("expires_at") @db.Timestamptz(3)
  uploadedAt       DateTime?  @map("uploaded_at") @db.Timestamptz(3)
  downloadCount    Int        @default(0) @map("download_count")
  lastDownloadedAt DateTime?  @map("last_downloaded_at") @db.Timestamptz(3)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, expiresAt])
  @@map("files")
}
