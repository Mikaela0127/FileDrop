# Application
# Local development may use HTTP. Production must use an exact public HTTPS origin.
APP_URL=http://localhost:3000
# Configure these together. Generate values using the README commands.
SESSION_SECRET=
UPLOAD_PASSWORD_HASH=
# Independent bearer secret used only by the scheduled cleanup endpoint.
CRON_SECRET=

# Local PostgreSQL. Production DATABASE_URL should be pooled and DIRECT_URL direct;
# both production values must use remote hosts with sslmode=require or stricter.
DATABASE_URL=postgresql://filedrop:filedrop@localhost:5432/filedrop
DIRECT_URL=postgresql://filedrop:filedrop@localhost:5432/filedrop

# Cloudflare R2. Keep the bucket private and scope the API token to this bucket.
# Copy real values only into an ignored local .env or the deployment provider.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
